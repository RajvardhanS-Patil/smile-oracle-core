# ===================================================
# Based Smiles - Environment Configuration
# ===================================================

# [Optional] Web3 Authentication (Privy)
# If omitted or left empty, Based Smiles automatically runs in Instant Demo Wallet mode
# with zero configuration, allowing 1-click testing with simulated Base wallet or MetaMask!
NEXT_PUBLIC_PRIVY_APP_ID=

# [Optional] Supabase Database & Storage
# If omitted, smiles are stored persistently in browser local storage and seed gallery.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [Optional] Base Smart Contract Address
# Defaults to the deployed Based Smiles contract on Base Mainnet:
NEXT_PUBLIC_CONTRACT_ADDRESS=0xf5526Ff322FBE97c31160A94A380093151Aa442F

# [Optional] OpenAI / Gemini Vision API key for dynamic AI Oracle smile evaluation
# If omitted, intelligent local smile analysis heuristics are used.
OPENAI_API_KEY=
